dup 105 /i put
dup 106 /j put
dup 108 /l put
dup 110 /n put
dup 111 /o put
dup 49 /one put
dup 112 /p put
dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 114 /r put
dup 115 /s put
dup 116 /t put
dup 51 /three put
dup 126 /tilde put
dup 50 /two put
dup 117 /u put
dup 119 /w put
dup 121 /y put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
