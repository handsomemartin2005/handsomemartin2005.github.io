@unpublished{zhang-rigor-omr,
  researcharea = {computer-vision},
  pdf = {/papers/rigor-omr.pdf},
  title = {{RIGOR-OMR}: Interpretable Geometric Relation Reasoning for Zero-Shot Cross-Domain Optical Music Recognition},
  year = {2026},
  status = {under-review},
  targetvenue = {AAAI 2027},
  reviewscores = {8, 4, 3, 5},
  selected = {true},
  keywords = {光学乐谱识别, 零样本学习, 几何关系推理},
  description = {利用谱线归一化几何信息与显式关系推理，实现零样本跨领域光学乐谱识别。},
  abstract = {光学乐谱识别（OMR）系统在域内基准上表现出色，但这些结果能否推广到从未见过的乐谱领域，仍缺乏研究。本文提出 RIGOR-OMR（Relation-aware Interpretable Geometry for Out-of-domain Recognition）。这一模块化框架利用谱线归一化后的几何信息指导视觉符号检测和显式关系推理，无需在目标域训练或针对特定数据集适配，即可重建结构化输出。为比较输出形式不同的系统，本文提出一种不依赖具体表示形式的音高—时值事件评估协议。在 Polish Scores 上，RIGOR-OMR 的 Event-F1 为 17.083，相较于 Sheet Music Transformer（SMT）和 Zeus 分别提升 357.8% 和 1182.4%。在 Debussy 上，RIGOR-OMR 明显优于 SMT，与 Zeus 表现相当。消融实验表明，显式关系推理是性能提升的主要来源。在 Polish Scores、Debussy、GrandStaff 和 OLiMPiC 上的实验表明，RIGOR-OMR 能在明显的领域偏移下实现零样本乐谱内容识别。}
}

